    "editorBracketHighlight.foreground3": "#56b6c2",
    "editorBracketHighlight.foreground4": "#e5c07b",
    "editorBracketHighlight.foreground5": "#7fd88f",
    "editorBracketHighlight.foreground6": "#5c9cf5",
    "editorLink.activeForeground": "#5c9cf5",
    "editorCodeLens.foreground": "#808080",
    "editorGutter.addedBackground": "#7fd88f",
    "editorGutter.modifiedBackground": "#e5c07b",
    "editorGutter.deletedBackground": "#e06c75",
    "editorError.foreground": "#e06c75",
    "editorWarning.foreground": "#e5c07b",
    "editorInfo.foreground": "#5c9cf5",
