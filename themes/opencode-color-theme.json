    "textSeparator.foreground": "#2a2a2a",
    "editor.background": "#0a0a0a",
    "editor.foreground": "#eeeeee",
    "editorCursor.foreground": "#fab283",
    "editor.selectionBackground": "#3c3c3c",
    "editor.inactiveSelectionBackground": "#2a2a2a",
    "editor.selectionHighlightBackground": "#3c3c3c88",
    "editor.lineHighlightBackground": "#141414",
    "editor.lineHighlightBorder": "#00000000",
    "editor.wordHighlightBackground": "#3c3c3c88",
    "editor.findMatchBackground": "#fab28355",
    "editor.findMatchHighlightBackground": "#fab28333",
    "editor.rangeHighlightBackground": "#1e1e1e",
    "editorLineNumber.foreground": "#484848",
    "editorLineNumber.activeForeground": "#fab283",
    "editorIndentGuide.background1": "#1e1e1e",
    "editorIndentGuide.activeBackground1": "#484848",
